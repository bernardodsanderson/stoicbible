  "author": "Bernardo Anderson",
  "homepage": "https://stoicbible-714.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernardodsanderson/stoicbible.git"
  },
  "bugs": {
    "url": "https://github.com/bernardodsanderson/stoicbible/issues"
  },
  "keywords": [
    "stoicism",
    "reading",
    "journaling",
    "tanstack-start",
    "firebase",
    "netlify",
    "react"
  ],
  "engines": {
    "node": ">=22"
  }
}
