# Firebase web-app configuration.
#
# Copy this file to `.env` and fill in the values from:
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
#
# These values are public by design (they ship to the browser), but each
# contributor should use their own Firebase project. Firestore security rules
# are the security boundary, not these values.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# Optional absolute site URL used for server-rendered auth fallbacks.
# In the browser the live origin is used automatically.
# VITE_PUBLIC_SITE_URL=http://localhost:8080
